{
  "name": "employee-absence-api",
  "version": "1.0.0",
  "description": "NestJS + Fastify + SOLID + Clean Architecture skeleton — TypeORM (PostgreSQL), MongoDB logging, Redis cache, S3 (AWS/Alibaba), Swagger, cookie auth, SWC, throttle/DDoS protection",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build --builder swc && node -e \"const fs=require('fs'); const path=require('path'); const src=path.resolve('src/logging/pretty-transport.cjs'); const out=path.resolve('dist/logging/pretty-transport.cjs'); fs.mkdirSync(path.dirname(out), {recursive:true}); fs.copyFileSync(src, out);\"",
    "start": "nest start --builder swc",
    "start:dev": "nest start --watch --builder swc",
    "start:prod": "node -e \"const fs=require('fs'); const path=require('path'); const src=path.resolve('src/logging/pretty-transport.cjs'); const out=path.resolve('dist/logging/pretty-transport.cjs'); fs.mkdirSync(path.dirname(out), {recursive:true}); if (fs.existsSync(src)) fs.copyFileSync(src, out);\" && node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/helmet": "^11.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "4.28.1",
    "ioredis": "^5.4.1",
    "mongoose": "^8.8.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "@swc/cli": "^0.5.1",
    "@swc/core": "^1.9.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^7.18.0"
  }
}
