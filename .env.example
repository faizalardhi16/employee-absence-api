# ===== App =====
NODE_ENV=development
PORT=3100
APP_NAME=nest-fastify-skeleton
APP_PREFIX=api

# ===== Logging (pino) =====
LOG_LEVEL=debug        # trace|debug|info|warn|error
LOG_DIR=logs           # folder output (app.log + error.log)

# ===== JWT / COOKIE AUTH =====
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# ===== CSRF PROTECTION (double-submit cookie + HMAC) =====
# Secret penandatangan token CSRF (HMAC-SHA256). WAJIB diganti di production!
CSRF_SECRET=change-me-in-production
CSRF_COOKIE_NAME=csrf_token      # cookie non-HttpOnly (dibaca JS frontend)
CSRF_HEADER_NAME=x-csrf-token    # header yang harus dikirim frontend

# ===== PostgreSQL (TypeORM) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nest_fastify
DB_SSL=false

# ===== MongoDB (logging) =====
# Isi username/password sesuai user MongoDB. authSource biasanya `admin`.
MONGO_URL=mongodb://mongo_user:mongo_password@localhost:27017/nest_fastify_logs?authSource=admin
MONGO_DB=nest_fastify_logs
MONGO_LOG_COLLECTION=logs

# ===== Redis (cache) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=cache:
REDIS_TTL=60

# ===== S3 — AWS =====
AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKET=your-bucket
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== S3 — Alibaba (OSS) =====
ALI_S3_REGION=oss-ap-southeast-1
ALI_S3_BUCKET=your-bucket
ALI_S3_ENDPOINT=
ALI_ACCESS_KEY_ID=
ALI_SECRET_ACCESS_KEY=

# ===== Active storage provider =====
STORAGE_PROVIDER=aws   # aws | alibaba
